# Copy to .env for local runs. NEVER commit .env (it's in .gitignore).
# In GitHub Actions these are provided as repository Secrets instead.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL where the feed + MP3s are served.
# GitHub Pages (serving from repo root) exposes the public/ folder under /public:
SITE_BASE_URL=https://unreadshelf15-creator.github.io/podcast-engine/public
